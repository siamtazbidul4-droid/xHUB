# =============================================================================
# KINETIX VIDEO PLATFORM - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control. It is already in .gitignore.

# -----------------------------------------------------------------------------
# REQUIRED: JWT secret for signing authentication tokens
# MUST be a strong random value (min 32 characters) in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_SECRET="YOUR_JWT_SECRET_KEY"

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# When deployed behind a reverse proxy / load balancer / hosting edge, set the
# number of trusted proxy hops so rate limiting keys on the real client IP.
# Leave unset (or 0) when the server is exposed directly. Never use an
# unbounded value such as "true" — clients could then spoof their IP via
# X-Forwarded-For.
# TRUST_PROXY=1

# -----------------------------------------------------------------------------
# Optional: App URL for self-referential links
# -----------------------------------------------------------------------------
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Optional: extra CORS origins (comma-separated).
# The SPA is served same-origin in production; only set this if a separate
# frontend origin must call the API. Never use "*" with credentials.
# -----------------------------------------------------------------------------
# ALLOWED_ORIGINS="https://your-app.onrender.com"

# -----------------------------------------------------------------------------
# Admin Authentication Credentials
# These are used exclusively by the admin login endpoint (/api/admin/login).
# The admin password is never exposed to the client.
# If unset, no administrator is seeded and admin login reports "not configured".
# -----------------------------------------------------------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your-secure-admin-password"
